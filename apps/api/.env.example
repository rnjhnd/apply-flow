# Optional: copy to apps/api/.env. Existing process variables take precedence.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_TIMEZONE=Asia/Manila

# Prefer `npm run db:env:init`: it generates independent passwords and matching URLs.
# These placeholders must be replaced; never commit apps/api/.env.
POSTGRES_DEV_PASSWORD=replace_with_a_unique_dev_password
POSTGRES_TEST_PASSWORD=replace_with_a_different_test_password
DATABASE_URL=postgresql://applyflow_dev:replace_with_a_unique_dev_password@127.0.0.1:15432/applyflow_dev
TEST_DATABASE_URL=postgresql://applyflow_test:replace_with_a_different_test_password@127.0.0.1:5433/applyflow_test
