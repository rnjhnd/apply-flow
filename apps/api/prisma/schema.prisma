generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension     = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(254)
  passwordHash String    @db.Text
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  sessions     Session[]
  applications JobApplication[]
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @db.Char(64)
  csrfToken  String   @db.Char(64)
  userId     String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum ApplicationStatus {
  SAVED
  APPLIED
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

// The status/date CHECK is maintained explicitly in 0002_job_applications SQL.
model JobApplication {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @db.Uuid
  company         String            @db.VarChar(160)
  jobTitle        String            @db.VarChar(200)
  status          ApplicationStatus @default(SAVED)
  applicationDate DateTime?         @db.Date
  location        String?           @db.VarChar(200)
  jobUrl          String?           @db.VarChar(2048)
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  // Positive-version CHECK is maintained in 0003_application_status_history.
  version         Int              @default(1)
  archivedAt      DateTime?         @db.Timestamptz(3)
  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  statusHistory   ApplicationStatusHistory[]

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
}

// Only actual transitions are recorded. No synthetic creation/backfill events.
// Permanent deletion requires a separately approved history-cleanup policy.
model ApplicationStatusHistory {
  id                 String            @id @default(uuid()) @db.Uuid
  applicationId      String            @db.Uuid
  fromStatus         ApplicationStatus
  toStatus           ApplicationStatus
  applicationVersion Int
  changedAt          DateTime          @default(now()) @db.Timestamptz(3)
  application        JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  // Also supports deterministic per-application revision ordering in either direction.
  @@unique([applicationId, applicationVersion])
}
